<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Lucid" Language="1033" Version="0.3.0" Manufacturer="Lucid contributors" UpgradeCode="E2F83EC3-EBF5-4AB2-950C-39E57A69F8AA">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Lucid is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder"><Directory Id="INSTALLFOLDER" Name="Lucid" /></Directory>
      <Directory Id="ProgramMenuFolder"><Directory Id="LucidMenu" Name="Lucid" /></Directory>
    </Directory>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="Associations" Guid="AF9474CF-3386-498C-9E36-DF6F0EFDB485">
        <RegistryValue Root="HKLM" Key="Software\Classes\Lucid.File" Value="Lucid text file" Type="string" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Lucid.File\DefaultIcon" Value="[INSTALLFOLDER]Lucid.exe,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Lucid.File\shell\open\command" Value="&quot;[INSTALLFOLDER]Lucid.exe&quot; &quot;%1&quot;" Type="string" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.c\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
