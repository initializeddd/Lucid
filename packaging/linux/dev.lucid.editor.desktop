[Desktop Entry]
Type=Application
Name=Lucid
GenericName=Code Editor
Comment=A minimal, GPU-accelerated code editor.
Exec=lucid %f
Icon=dev.lucid.editor
Terminal=false
Categories=Development;TextEditor;
MimeType=text/plain;text/x-c;text/x-c++;text/x-python;text/javascript;application/json;application/xml;text/html;text/css;text/markdown;
Keywords=code;editor;development;
StartupNotify=true
StartupWMClass=Lucid
