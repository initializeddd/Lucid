{
  "name": "Test Coverage Lens",
  "version": "0.1.0",
  "description": "Import local LCOV or Cobertura line and supported branch coverage; reports may be stale.",
  "requires": [
    "coverage-lcov-v1",
    "coverage-cobertura-v1",
    "coverage-cobertura-branches-v1"
  ],
  "permissions": {
    "project": true,
    "network": false,
    "processes": false,
    "settings": false
  },
  "commands": [
    {
      "title": "Import LCOV report",
      "action": "coverage-lcov"
    },
    {
      "title": "Import Cobertura XML report",
      "action": "coverage-cobertura"
    }
  ]
}
