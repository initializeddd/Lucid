{
  "name": "Test Runner Plus",
  "version": "0.1.0",
  "description": "Run selected CTest tests or import and compare local JUnit snapshots.",
  "requires": [
    "ctest-runner-v2",
    "junit-import-v1"
  ],
  "permissions": {
    "project": true,
    "network": false,
    "processes": true,
    "settings": true
  },
  "commands": [
    {
      "title": "Browse CTest tests",
      "action": "run-ctest"
    },
    {
      "title": "Import JUnit report",
      "action": "import-junit"
    }
  ]
}
