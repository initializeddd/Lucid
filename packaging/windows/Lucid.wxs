          <RegistryValue Root="HKLM" Key="Software\Classes\.hpp\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.py\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.js\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.jsx\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.ts\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.tsx\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.json\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.html\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.css\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.xml\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.yaml\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.yml\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.toml\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.rs\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.go\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.java\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
          <RegistryValue Root="HKLM" Key="Software\Classes\.sh\OpenWithProgids" Name="Lucid.File" Type="string" Value="" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="LucidMenu">
      <Component Id="StartMenuShortcut" Guid="7D319C83-5C1A-4555-85E3-7C8BFCF50484">
        <Shortcut Id="LucidShortcut" Name="Lucid" Target="[INSTALLFOLDER]Lucid.exe" WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveLucidMenu" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Lucid" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <Feature Id="Main" Title="Lucid" Level="1">
      <ComponentGroupRef Id="Payload" />
      <ComponentRef Id="Associations" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
